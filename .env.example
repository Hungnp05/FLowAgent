# Copy this file to .env. Keys can also be entered in the app (Cài đặt API page), which take priority.
LLM_PROVIDER=gemini

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

DATABASE_URL=sqlite:///data/flowagent.db
CHAT_HISTORY_PATH=data/chat_history.db
TIMEZONE=Asia/Ho_Chi_Minh
